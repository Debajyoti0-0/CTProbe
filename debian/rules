#!/usr/bin/make -f
# Uses dh + pybuild with the pyproject plugin (reads pyproject.toml).

export PYBUILD_NAME=ctprobe

# The test suite is fully offline/mocked, so it is safe to run at build time.
# It is skipped automatically when the build profile sets nocheck.
export PYBUILD_TEST_PYTEST=1

%:
	dh $@ --with python3 --buildsystem=pybuild

# Install the man page (see debian/manpages).
override_dh_installman:
	dh_installman
